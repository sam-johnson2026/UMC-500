# --- Public (shipped to the browser; safe because Supabase RLS guards the data) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server only (Vercel functions in /api). Never prefix with VITE_. ---
# Same project URL / anon key, used to verify the caller's session token.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# https://www.themoviedb.org/settings/api  (v3 key or v4 read-access token)
TMDB_API_KEY=
# https://rawg.io/apidocs
RAWG_API_KEY=
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional override (default claude-opus-5-5)
# ANTHROPIC_MODEL=claude-sonnet-5-5
